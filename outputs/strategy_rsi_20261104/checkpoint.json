  "items": [
    {
      "id": "s0006",
      "text": "After one semantic and one keyword sweep per clue, stop rephrasing; convert date constraints into month-day and year windows and search those",
      "created_by": "merge",
      "ts": "2026-11-06T16:40:47+08:00",
      "total_score": 65,
      "rating_count": 89,
      "source_ids": [
        "s0006",
        "x3.4.1.0"
      ]
    },
    {
      "id": "s0005",
      "text": "Cap total probes across all clues, launch independent chains concurrently in one wave, and retire failed clues instead of re-reading",
      "created_by": "merge",
      "ts": "2026-11-06T16:40:47+08:00",
      "total_score": 44,
      "rating_count": 89,
      "source_ids": [
        "s0005"
      ]
    },
    {
      "id": "s0002",
      "text": "Require proof only for distinguishing clauses; once one candidate covers them, answer and name any unconfirmed corroborating clause",
      "created_by": "merge",
      "ts": "2026-11-06T16:40:47+08:00",
      "total_score": 26,
      "rating_count": 89,
      "source_ids": [
        "s0002"
      ]
    },
    {
      "id": "s0004",
      "text": "Launch clue chains in one parallel wave; pin the most discriminative numeric clause before dependent hops, verify separating clauses, accept one passage, name gaps, and retire after two misses",
      "created_by": "merge",
      "ts": "2026-11-06T16:40:47+08:00",
      "total_score": 25,
      "rating_count": 83,
      "source_ids": [
        "s0004",
        "x3.4.5.0",
        "x3.4.9.0",
        "x3.4.9.1"
      ]
    },
    {
      "id": "s0014",
      "text": "Give each parallel subagent three probes; require one candidate plus one verbatim quote, accepting only candidates satisfying the discriminating date and relationship clauses together",
      "created_by": "merge",
      "ts": "2026-11-06T16:40:47+08:00",
      "total_score": 25,
      "rating_count": 53,
      "source_ids": [
        "s0014",
        "x3.4.1.1"
      ]
    },
    {
      "id": "s0009",
      "text": "Track clause-to-passage coverage separately; accept when discriminative clauses pin one candidate and remaining clauses each have confirming passages",
      "created_by": "merge",
      "ts": "2026-11-06T16:40:47+08:00",
      "total_score": 15,
      "rating_count": 61,
      "source_ids": [
        "s0009",
        "x3.4.0.0"
      ]
    },
    {
      "id": "s0003",
      "text": "Never enumerate candidate rosters; keep only the single candidate satisfying every clause and discard the rest once one confirming passage exists",
      "created_by": "merge",
      "ts": "2026-11-06T16:40:47+08:00",
      "total_score": 11,
      "rating_count": 89,
      "source_ids": [
        "s0003"
      ]
    },
    {
      "id": "s0013",
      "text": "Launch clue chains in one parallel wave; cap each clue at two synonym probes per mode, probe one representative per family, then pivot to entity pages and retire empties",
      "created_by": "merge",
      "ts": "2026-11-06T16:40:47+08:00",
      "total_score": 6,
      "rating_count": 65,
      "source_ids": [
        "s0013",
        "x3.4.0.1",
        "x3.4.2.0",
        "x3.4.5.1"
      ]
    },
    {
      "id": "s0018",
      "text": "Accept birth-year and birthplace facts from separate passages naming the same relative; reserve single-passage quotation for the answer's own wording",
      "created_by": "merge",
      "ts": "2026-11-06T16:40:47+08:00",
      "total_score": 4,
      "rating_count": 26,
      "source_ids": [
        "s0018"
      ]
    },
    {
      "id": "s0012",
      "text": "For verbatim-text questions, prefer canonical or audio-derived sources; verify wording, line boundaries, and numbering in a second passage, never filling gaps from memory",
      "created_by": "merge",
      "ts": "2026-11-06T16:40:47+08:00",
      "total_score": 3,
      "rating_count": 15,
      "source_ids": [
        "s0012"
      ]
    },
    {
      "id": "s0011",
      "text": "For nth-line questions, count the source's own printed line breaks including parentheticals, never reflowed text; otherwise drop stage directions and verify with a second transcription",
      "created_by": "merge",
      "ts": "2026-11-06T16:40:47+08:00",
      "total_score": 2,
      "rating_count": 1,
      "source_ids": [
        "s0011"
      ]
    },
    {
      "id": "s0016",
      "text": "Bootstrap the entity from biography clues in one document, then validate discography clues only after it names the artist",
      "created_by": "merge",
      "ts": "2026-11-06T16:40:47+08:00",
      "total_score": 1,
      "rating_count": 5,
      "source_ids": [
        "s0016"
      ]
    },
    {
      "id": "s0019",
      "text": "For full birth-name clues, quote the field explicitly labeled birth name, not a narrative lead sentence",
      "created_by": "merge",
      "ts": "2026-11-06T16:40:47+08:00",
      "total_score": 1,
      "rating_count": 1,
      "source_ids": [
        "s0019"
      ]
    },
    {
      "id": "s0001",
      "text": "Extract every title listed under the same author verbatim, choose with the separating clue, confirm spelling and prepositions from source, and stop after one targeted miss",
      "created_by": "merge",
      "ts": "2026-11-06T16:40:47+08:00",
      "total_score": 0,
      "rating_count": 58,
      "source_ids": [
        "s0001"
      ]
    },
    {
      "id": "s0007",
      "text": "When identifying an organization's members, exclude credits affiliated with publishers, contractors, or external vendors even if their names appear on multiple titles",
      "created_by": "merge",
      "ts": "2026-11-06T16:40:47+08:00",
      "total_score": -1,
      "rating_count": 20,
      "source_ids": [
        "s0007"
      ]
    },
    {
      "id": "s0017",
      "text": "Merge parent-generation birth and marriage clues into one era band; require every candidate to satisfy it before checking actor-level attributes",
      "created_by": "merge",
      "ts": "2026-11-06T16:40:47+08:00",
      "total_score": -2,
      "rating_count": 9,
      "source_ids": [
        "s0017"
      ]
    },
    {
      "id": "s0015",
      "text": "Enumerate a season's episode titles from one structural index, then filter by the naming clue before plot details",
